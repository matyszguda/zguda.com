{
  "name": "zguda-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "charts:generate": "node scripts/update-revenue-chart.mjs && node scripts/update-steady-chart.mjs",
    "charts:check": "node scripts/update-revenue-chart.mjs --check && node scripts/update-steady-chart.mjs --check",
    "build": "npm run charts:check && vite build --base=./",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "vite": "^7.2.0"
  }
}
